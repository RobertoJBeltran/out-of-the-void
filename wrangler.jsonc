{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "out-of-the-void",
  "compatibility_date": "2026-07-30",
  // Static assets only — no worker script. SvelteKit adapter-static output.
  "assets": {
    "directory": "./build"
  },
  "workers_dev": true,
  "routes": [{ "pattern": "ootv.wickeddeeds.lol", "custom_domain": true }]
}
